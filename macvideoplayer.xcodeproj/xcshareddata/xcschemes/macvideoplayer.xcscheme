            <ActionContent
               title = "Generate FFmpeg dSYMs"
               scriptText = "for lib in &quot;$ARCHIVE_PATH&quot;/Products/Applications/macvideoplayer.app/Contents/Frameworks/*.dylib; do&#10;  name=$(basename &quot;$lib&quot;)&#10;  rm -rf &quot;$ARCHIVE_PATH/dSYMs/$name.dSYM&quot;&#10;  dsymutil &quot;$lib&quot; -o &quot;$ARCHIVE_PATH/dSYMs/$name.dSYM&quot; 2&gt;/dev/null || true&#10;done&#10;">
               <EnvironmentBuildable>
